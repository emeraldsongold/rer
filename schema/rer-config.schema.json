{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RER Configuration Schema",
  "description": "Configuration schema for RER (RER Engineering Relay)",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "instance": {
      "description": "Single instance configuration (alternative to `instances`).",
      "anyOf": [
        {
          "$ref": "#/definitions/InstanceConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "instances": {
      "description": "List of RER relay instances.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/InstanceConfig"
      }
    },
    "version": {
      "description": "Configuration format version (e.g. \"1\" or \"1.0\").",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Bpv7InspectionConfig": {
      "description": "Opt-in BPv7 passive inspection configuration (SPEC §14, §8).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether BPv7 inspection is enabled. Defaults to true when bpv7 section is present.",
          "default": true,
          "type": "boolean"
        },
        "extract_eids": {
          "description": "Whether to extract destination and source endpoint identifiers (EIDs). Defaults to true.",
          "default": true,
          "type": "boolean"
        },
        "max_inspect_bytes": {
          "description": "Maximum number of bytes to inspect for BPv7 headers. Defaults to 4096.",
          "default": 4096,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "BufferConfig": {
      "description": "Buffer and queue bounding configuration (SPEC §17).",
      "type": "object",
      "properties": {
        "drop_policy": {
          "description": "Drop policy under queue exhaustion.",
          "anyOf": [
            {
              "$ref": "#/definitions/DropPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_packet_size": {
          "description": "Maximum packet size in bytes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "max_queue_size": {
          "description": "Maximum queue size in packets.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ByteOrder": {
      "description": "Supported byte orders for binary sequence extraction (SPEC §8).",
      "type": "string",
      "enum": [
        "big_endian",
        "little_endian"
      ]
    },
    "CcsdsConfig": {
      "description": "Configuration for CCSDS Space Packet parsing, validation, and sequence tracking (SPEC §14).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable CCSDS primary header parsing and validation. Defaults to true.",
          "default": true,
          "type": "boolean"
        },
        "filter_apids": {
          "description": "Optional allowlist of APIDs to accept/track. If None, all APIDs are accepted.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0.0
          }
        },
        "framing": {
          "description": "Optional framing mode override (\"length_prefix\" or \"ccsds\").",
          "anyOf": [
            {
              "$ref": "#/definitions/FramingMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "ignore_idle_apid": {
          "description": "Exclude idle packets (APID 2047 / 0x7FF) from sequence tracking and gap alerts. Defaults to true.",
          "default": true,
          "type": "boolean"
        },
        "passthrough_on_error": {
          "description": "When true, datagrams failing CCSDS validation are forwarded unchanged to destination. Defaults to false.",
          "default": false,
          "type": "boolean"
        },
        "track_sequences": {
          "description": "Track sequence continuity independently per APID. Defaults to true.",
          "default": true,
          "type": "boolean"
        },
        "validate_length": {
          "description": "Validate that datagram size matches Packet Data Length + 7. Defaults to true.",
          "default": true,
          "type": "boolean"
        },
        "validate_version": {
          "description": "Enforce Packet Version Number == 0. Defaults to true.",
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ConnectionMode": {
      "description": "Connection modes for endpoints.",
      "type": "string",
      "enum": [
        "listen",
        "connect"
      ]
    },
    "DropPolicy": {
      "description": "Drop policies under queue exhaustion.",
      "type": "string",
      "enum": [
        "drop_oldest",
        "drop_newest",
        "reject"
      ]
    },
    "EndpointConfig": {
      "description": "Network endpoint configuration.",
      "type": "object",
      "required": [
        "address",
        "transport"
      ],
      "properties": {
        "address": {
          "description": "Network endpoint address in \"host:port\" format (e.g. \"127.0.0.1:5000\").",
          "type": "string"
        },
        "framing": {
          "description": "Optional framing mode for TCP endpoints (\"length_prefix\" or \"ccsds\"). Defaults to length_prefix.",
          "anyOf": [
            {
              "$ref": "#/definitions/FramingMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "description": "Connection mode (\"listen\" or \"connect\").",
          "anyOf": [
            {
              "$ref": "#/definitions/ConnectionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "description": "Transport protocol (\"udp\" or \"tcp\").",
          "allOf": [
            {
              "$ref": "#/definitions/TransportType"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "FramingMode": {
      "description": "Framing modes for TCP streams (SPEC §5, §14).",
      "oneOf": [
        {
          "description": "Standard 4-byte big-endian length prefix (default).",
          "type": "string",
          "enum": [
            "length_prefix"
          ]
        },
        {
          "description": "CCSDS Space Packet length-based framing (packet data length field + 7 bytes).",
          "type": "string",
          "enum": [
            "ccsds"
          ]
        }
      ]
    },
    "InspectionConfig": {
      "description": "Opt-in packet inspection and payload preview configuration (SPEC §8, §14).",
      "type": "object",
      "properties": {
        "ascii_preview": {
          "description": "Whether ASCII payload previews are enabled. Defaults to false (opt-in).",
          "default": false,
          "type": "boolean"
        },
        "bpv7": {
          "description": "Optional BPv7 passive bundle inspection configuration (SPEC §14, §8). Defaults to None.",
          "anyOf": [
            {
              "$ref": "#/definitions/Bpv7InspectionConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "hex_preview": {
          "description": "Whether hexadecimal payload previews are enabled. Defaults to false (opt-in).",
          "default": false,
          "type": "boolean"
        },
        "ltp": {
          "description": "Optional LTP passive segment inspection configuration (SPEC §14, §8). Defaults to None.",
          "anyOf": [
            {
              "$ref": "#/definitions/LtpInspectionConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_preview_bytes": {
          "description": "Maximum length in bytes for previews (length-bounded). Defaults to 64 bytes.",
          "default": 64,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "InstanceConfig": {
      "description": "Configuration for an individual RER relay instance.",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "buffer": {
          "description": "Instance-level bounded buffer and queue limits.",
          "anyOf": [
            {
              "$ref": "#/definitions/BufferConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_id": {
          "description": "Direct correlation ID on instance (alternative to test_mode.correlation_id).",
          "type": [
            "string",
            "null"
          ]
        },
        "expiry_seconds": {
          "description": "Direct expiry in seconds on instance (alternative to test_mode.expiry_seconds).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "description": "Unique identity of the instance.",
          "type": "string"
        },
        "logical_interfaces": {
          "description": "Logical interfaces pairing directional streams.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/LogicalInterfaceConfig"
          }
        },
        "management": {
          "description": "Management and diagnostics interface configuration.",
          "anyOf": [
            {
              "$ref": "#/definitions/ManagementConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_events": {
          "description": "Direct max events on instance (alternative to test_mode.max_events).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "metrics": {
          "description": "Prometheus/OpenMetrics metrics endpoint configuration (SPEC §15).",
          "anyOf": [
            {
              "$ref": "#/definitions/MetricsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "description": "Diagnostic and operational profile (\"production\", \"debug\", or \"test\").",
          "default": "production",
          "allOf": [
            {
              "$ref": "#/definitions/OperationalMode"
            }
          ]
        },
        "name": {
          "description": "Human-readable name or label for the instance.",
          "type": [
            "string",
            "null"
          ]
        },
        "prior_mode": {
          "description": "Direct prior mode on instance (alternative to test_mode.prior_mode).",
          "anyOf": [
            {
              "$ref": "#/definitions/OperationalMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "streams": {
          "description": "Forwarding streams configured on this instance.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/StreamConfig"
          }
        },
        "test_mode": {
          "description": "Test mode configuration (correlation ID, expiry, bounds, prior mode) (SPEC §10).",
          "anyOf": [
            {
              "$ref": "#/definitions/TestModeConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LogicalInterfaceConfig": {
      "description": "Logical interface pairing directional streams (SPEC §6).",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "Unique identity of the logical interface.",
          "type": "string"
        },
        "name": {
          "description": "Human-readable label or description.",
          "type": [
            "string",
            "null"
          ]
        },
        "rx_stream": {
          "description": "Receive / downlink stream identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "tx_stream": {
          "description": "Transmit / uplink stream identity.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LtpInspectionConfig": {
      "description": "Opt-in LTP passive inspection configuration (SPEC §14, §8).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether LTP inspection is enabled. Defaults to true when ltp section is present.",
          "default": true,
          "type": "boolean"
        },
        "max_inspect_bytes": {
          "description": "Maximum number of bytes to inspect for LTP headers. Defaults to 4096.",
          "default": 4096,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ManagementConfig": {
      "description": "Management plane configuration (SPEC §9).",
      "type": "object",
      "required": [
        "endpoint"
      ],
      "properties": {
        "auth_token": {
          "description": "Optional authentication token for remote management.",
          "anyOf": [
            {
              "$ref": "#/definitions/SecretString"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "description": "Whether the management plane is enabled.",
          "default": true,
          "type": "boolean"
        },
        "endpoint": {
          "description": "Bind address or socket path (e.g. \"127.0.0.1:9090\" or \"/run/rer/mgmt.sock\").",
          "type": "string"
        },
        "tls": {
          "description": "Optional TLS configuration for remote management.",
          "anyOf": [
            {
              "$ref": "#/definitions/TlsConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MetricsConfig": {
      "description": "Prometheus and OpenMetrics metrics endpoint configuration (SPEC §15).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the metrics HTTP/TCP endpoint is enabled.",
          "default": true,
          "type": "boolean"
        },
        "endpoint": {
          "description": "Bind address for the metrics endpoint (e.g. \"127.0.0.1:9100\"). Bound to loopback by default.",
          "default": "127.0.0.1:9100",
          "type": "string"
        },
        "path": {
          "description": "HTTP request path for metrics scraping (e.g. \"/metrics\"). Defaults to \"/metrics\".",
          "default": "/metrics",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OperationalMode": {
      "description": "Operational diagnostic modes (SPEC §10).",
      "type": "string",
      "enum": [
        "production",
        "debug",
        "test"
      ]
    },
    "SecretString": {
      "description": "A sensitive string value (e.g. token or secret) redacted in effective configurations",
      "writeOnly": true,
      "type": "string"
    },
    "SequenceConfig": {
      "description": "Configuration for packet sequence extraction and continuity tracking (SPEC §8).",
      "type": "object",
      "properties": {
        "ascii_preview": {
          "description": "Opt-in ASCII preview of payload bytes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "byte_order": {
          "description": "Byte order of the sequence number field. Defaults to big-endian (network byte order).",
          "default": "big_endian",
          "allOf": [
            {
              "$ref": "#/definitions/ByteOrder"
            }
          ]
        },
        "enabled": {
          "description": "Whether sequence tracking is enabled. Defaults to true when this section is present.",
          "default": true,
          "type": "boolean"
        },
        "hex_preview": {
          "description": "Opt-in hexadecimal preview of payload bytes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_preview_bytes": {
          "description": "Maximum length in bytes for previews (length-bounded).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "offset": {
          "description": "Byte offset of the sequence number in packet payload (0-indexed). Defaults to 0.",
          "default": 0,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "rollover_threshold": {
          "description": "Optional sequence rollover / modulus value (e.g. 65536 for 16-bit). Defaults to 2^(8*width).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "width": {
          "description": "Width of the sequence field in bytes (1, 2, 4, or 8). Defaults to 4.",
          "default": 4,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "StreamConfig": {
      "description": "Configuration for a forwarding stream (SPEC §5).",
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "buffer": {
          "description": "Optional stream-level buffer and queue limits.",
          "anyOf": [
            {
              "$ref": "#/definitions/BufferConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "ccsds": {
          "description": "Optional CCSDS Space Packet parsing, validation, and sequence tracking configuration (SPEC §14). Off by default.",
          "anyOf": [
            {
              "$ref": "#/definitions/CcsdsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "description": "Optional description of the stream.",
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "description": "Stream destination endpoint (conflicts with `destinations`).",
          "anyOf": [
            {
              "$ref": "#/definitions/EndpointConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "destinations": {
          "description": "Multiple destination endpoints for fan-out (conflicts with `destination`).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/EndpointConfig"
          }
        },
        "framing": {
          "description": "Optional framing mode for TCP streams (\"length_prefix\" or \"ccsds\"). Defaults to length_prefix.",
          "anyOf": [
            {
              "$ref": "#/definitions/FramingMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Unique identity of the stream.",
          "type": "string"
        },
        "inspection": {
          "description": "Optional packet inspection and preview configuration (SPEC §8). Off by default.",
          "anyOf": [
            {
              "$ref": "#/definitions/InspectionConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "description": "Optional sequence extraction and tracking configuration (SPEC §8). Off by default.",
          "anyOf": [
            {
              "$ref": "#/definitions/SequenceConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "Stream forwarding source.",
          "allOf": [
            {
              "$ref": "#/definitions/EndpointConfig"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "TestModeConfig": {
      "description": "Test mode configuration parameters (SPEC §10).",
      "type": "object",
      "properties": {
        "correlation_id": {
          "description": "Correlation identifier spanning multiple relays.",
          "type": [
            "string",
            "null"
          ]
        },
        "expiry_seconds": {
          "description": "Configured test run expiry / duration in seconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_events": {
          "description": "Configured event limit for the test run before reaching bound.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "prior_mode": {
          "description": "Diagnostic profile to revert to upon expiry or reaching bounds (defaults to production).",
          "anyOf": [
            {
              "$ref": "#/definitions/OperationalMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "TlsConfig": {
      "description": "TLS configuration for management traffic encryption.",
      "type": "object",
      "required": [
        "cert_file",
        "key_file"
      ],
      "properties": {
        "cert_file": {
          "description": "Path to TLS certificate file.",
          "type": "string"
        },
        "key_file": {
          "description": "Path to TLS private key file.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TransportType": {
      "description": "Supported transport protocols (SPEC §5).",
      "type": "string",
      "enum": [
        "udp",
        "tcp"
      ]
    }
  }
}
